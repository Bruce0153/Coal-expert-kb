# Remote model providers
DASHSCOPE_API_KEY=

# Production configuration
COAL_KB_CONFIG=configs/prod.yaml
COAL_KB_PUBLIC_MODE=true
COAL_KB_DATA_ROOT=/app/data
COAL_KB_ELASTIC_URL=http://elasticsearch.railway.internal:9200

# Generate strong independent secrets before deployment.
COAL_KB_SESSION_SECRET=
COAL_KB_ADMIN_SECRET=

# Replace with the Railway/custom public origins that should be allowed.
COAL_KB_ALLOWED_ORIGINS=https://your-domain.example
COAL_KB_PUBLIC_RESEARCH_ROUTES=standard,graph

# Public traffic limits
COAL_KB_MAX_QUERY_CHARS=4000
COAL_KB_RATE_LIMIT_REQUESTS=30
COAL_KB_RATE_LIMIT_WINDOW_SECONDS=60
COAL_KB_MAX_CONCURRENT_QUERIES=4

# Admin upload limits
COAL_KB_UPLOAD_MAX_FILES=10
COAL_KB_UPLOAD_MAX_FILE_BYTES=26214400
COAL_KB_UPLOAD_MAX_TOTAL_BYTES=104857600
